# Copy to backend/.env and fill in what you need. Lines marked optional can stay empty.
# The app starts with only DATABASE_URL set; the data sources that need a key
# return an error or skip that source.

# Required: a PostgreSQL database (see docs/docs/contributing/overview.md)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghanaapi_local?schema=public"

# Port the API listens on (default 3000)
PORT=3000
NODE_ENV=development

# Optional API keys for the upstream data sources
OPEN_ROUTE_API_KEY=
HERE_API_KEY=
GRAPHHOPPER_API_KEY=
FIXER_API_KEY=
EXCHANGERATE_API_KEY=

# Optional: a User-Agent for OpenStreetMap / Nominatim requests (identify your app)
NOMINATIM_USER_AGENT="GhanaAPI-local/1.0 (contact: you@example.com)"

# Optional: a GTFS feed URL for transport stops. Leave empty; do not use a placeholder host.
GHANA_GTFS_URL=

# Optional: how many reverse proxies sit in front of the API (0 when running locally)
RATE_LIMIT_PROXY_HOPS=0
